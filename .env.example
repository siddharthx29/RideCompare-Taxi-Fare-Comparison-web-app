# Copy to .env and replace the password with a long, random, URL-safe value.
POSTGRES_USER=ridecompare
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_URL_SAFE_PASSWORD
POSTGRES_DB=ridecompare
CORS_ORIGINS=http://localhost:8080

# Mapbox Access Token (Sign up free at https://www.mapbox.com)
# Used for Mapbox Search Box API (/suggest, /retrieve) and Mapbox Geocoding API (/reverse)
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here
MAPBOX_SERVER_TOKEN=your_mapbox_server_token_here
MAPBOX_PUBLIC_TOKEN=your_mapbox_public_token_here
GEOCODING_PROVIDER=mapbox

# Optional Geoapify Geocoding API Key (Alternative provider)
GEOAPIFY_API_KEY=your_geoapify_api_key_here