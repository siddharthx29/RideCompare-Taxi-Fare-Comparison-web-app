# Copy to .env and replace the password with a long, random, URL-safe value.
POSTGRES_USER=ridecompare
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_URL_SAFE_PASSWORD
POSTGRES_DB=ridecompare
CORS_ORIGINS=http://localhost:8080
# Geoapify Geocoding API Key (Free tier at https://www.geoapify.com)
GEOAPIFY_API_KEY=your_geoapify_api_key_here