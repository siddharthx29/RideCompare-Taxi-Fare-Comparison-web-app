# ==============================================================================
# RIDECOMPARE - ENVIRONMENT VARIABLES REFERENCE (.env.example)
# ==============================================================================

# Core backend runtime
ENV=development
ENVIRONMENT=development
PORT=5000
HOST=0.0.0.0
WORKERS=1

# Database Configuration
# Local SQLite default:
DATABASE_URL=sqlite:///./backend/app/ridecompare.db
# PostgreSQL (production or Docker):
# DATABASE_URL=postgresql://ridecompare:password@localhost:5432/ridecompare
POSTGRES_USER=ridecompare
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_URL_SAFE_PASSWORD
POSTGRES_DB=ridecompare

# CORS & Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
ML_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Security Key for Admin actions
ADMIN_KEY=your_secure_random_admin_key_here

# Frontend (Vite)
# Leave empty for relative path proxying (Vite proxy in dev, vercel.json rewrites in prod)
VITE_API_URL=

# Geocoding & Mapping
# Provider options: 'mapbox', 'photon', 'nominatim', or 'geoapify'
GEOCODING_PROVIDER=mapbox
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here
MAPBOX_PUBLIC_TOKEN=your_mapbox_public_token_here
MAPBOX_SECRET_TOKEN=
MAPBOX_SERVER_TOKEN=
VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_public_token_here

# Free Fallback Geocoding Services
PHOTON_BASE_URL=https://photon.komoot.io
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=RideCompare/3.0
LOCATION_CACHE_TTL_DAYS=14

# Optional Geoapify Geocoding API Key (Alternative provider)
GEOAPIFY_API_KEY=

# Optional provider quote APIs (leave unset to use built-in ML estimation model)
UBER_API_KEY=
LYFT_API_KEY=
OLA_API_KEY=
RAPIDO_API_KEY=
BOLT_API_KEY=
GRAB_API_KEY=
