# Local development uses SQLite by default. Set a PostgreSQL URL only when needed.
DATABASE_URL=sqlite:///./ridecompare.db

# Server Port
PORT=5000

# Environment Mode (development | production)
ENVIRONMENT=development

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# Optional Admin Key (Protects internal ML endpoints in production)
ADMIN_KEY=your_secure_admin_key_here

# Mapbox Access Token (Sign up at https://www.mapbox.com)
# Primary location provider for Mapbox Search Box API (/suggest, /retrieve) and Mapbox Geocoding (/reverse)
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here
MAPBOX_PUBLIC_TOKEN=your_mapbox_public_token_here
GEOCODING_PROVIDER=mapbox

# Optional Geoapify Geocoding API Key (Alternative fallback)
GEOAPIFY_API_KEY=your_geoapify_api_key_here
