# Local development uses SQLite by default. Set a PostgreSQL URL only when needed.
DATABASE_URL=sqlite:///./ridecompare.db

# Server Port
PORT=5000

# Environment Mode (development | production)
ENVIRONMENT=development

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# Optional Admin Key (Protects internal ML endpoints in production)
ADMIN_KEY=your_secure_admin_key_here
