# ==============================================================================
# RIDECOMPARE - VERCEL ENVIRONMENT VARIABLE IMPORT FILE
# ==============================================================================
# You can directly import this file into Vercel:
# Project Settings -> Environment Variables -> "Import .env"
# ==============================================================================

# Core backend & runtime
ENV=production
ENVIRONMENT=production
PORT=5000
HOST=0.0.0.0
WORKERS=1

# CORS & Allowed Origins
CORS_ORIGINS=https://ridecompare.vercel.app
ALLOWED_ORIGINS=https://ridecompare.vercel.app
ML_ALLOWED_ORIGINS=https://ridecompare.vercel.app

# Security
ADMIN_KEY=rc_live_admin_9f3b7c2a1e4d805b6e2c8a4f7d0e3b1a

# Database Configuration
# If Neon Postgres integration is added in Vercel, Vercel sets DATABASE_URL automatically.
# Otherwise, SQLite will run out of /tmp/ridecompare.db in serverless mode.
DATABASE_URL=sqlite:///./ridecompare.db

# Frontend (Vite)
# Leave empty for full-stack Vercel deployment (handled by vercel.json rewrites)
VITE_API_URL=

# Geocoding & Mapping
GEOCODING_PROVIDER=mapbox
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here
MAPBOX_PUBLIC_TOKEN=your_mapbox_public_token_here
MAPBOX_SECRET_TOKEN=
MAPBOX_SERVER_TOKEN=
VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_public_token_here

# Geocoding fallbacks
PHOTON_BASE_URL=https://photon.komoot.io
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=RideCompare/3.0 (https://ridecompare.vercel.app; contact: admin@ridecompare.com)
LOCATION_CACHE_TTL_DAYS=14
GEOAPIFY_API_KEY=

# Optional Provider APIs (leave empty to use built-in ML estimation models)
UBER_API_KEY=
LYFT_API_KEY=
OLA_API_KEY=
RAPIDO_API_KEY=
BOLT_API_KEY=
GRAB_API_KEY=
