# Vercel environment variable import template.
# Replace placeholder values before importing this file into Vercel.

# Core backend
DATABASE_URL=sqlite:///./ridecompare.db
PORT=5000
HOST=0.0.0.0
WORKERS=1
ENVIRONMENT=production
ENV=production
ADMIN_KEY=REPLACE_WITH_A_SECURE_ADMIN_KEY
CORS_ORIGINS=https://YOUR-VERCEL-DOMAIN.vercel.app
ALLOWED_ORIGINS=https://YOUR-VERCEL-DOMAIN.vercel.app
ML_ALLOWED_ORIGINS=https://YOUR-VERCEL-DOMAIN.vercel.app

# Mapbox and geocoding
MAPBOX_ACCESS_TOKEN=REPLACE_WITH_MAPBOX_ACCESS_TOKEN
MAPBOX_SECRET_TOKEN=REPLACE_WITH_MAPBOX_SECRET_SK_TOKEN
MAPBOX_SERVER_TOKEN=REPLACE_WITH_MAPBOX_SERVER_TOKEN
MAPBOX_PUBLIC_TOKEN=REPLACE_WITH_MAPBOX_PUBLIC_TOKEN
GEOCODING_PROVIDER=mapbox
GEOAPIFY_API_KEY=
PHOTON_BASE_URL=https://photon.komoot.io
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=RideCompare/3.0
LOCATION_CACHE_TTL_DAYS=14

# Optional provider quote APIs
UBER_API_KEY=
LYFT_API_KEY=
OLA_API_KEY=
RAPIDO_API_KEY=
BOLT_API_KEY=
GRAB_API_KEY=

# Frontend
VITE_API_URL=
VITE_MAPBOX_ACCESS_TOKEN=REPLACE_WITH_MAPBOX_PUBLIC_TOKEN

# PostgreSQL values are only needed if DATABASE_URL is changed to PostgreSQL.
POSTGRES_USER=ridecompare
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_URL_SAFE_PASSWORD
POSTGRES_DB=ridecompare
