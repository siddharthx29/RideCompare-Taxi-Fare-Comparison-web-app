# ==============================================================================
# RIDECOMPARE - VERCEL PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Upload / Import this file directly into Vercel:
# Vercel Dashboard -> Your Project -> Settings -> Environment Variables -> Import
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE ENVIRONMENT & RUNTIME
# ------------------------------------------------------------------------------
ENV=production
ENVIRONMENT=production
PORT=5000
HOST=0.0.0.0
WORKERS=1

# ------------------------------------------------------------------------------
# 2. CORS & DOMAINS
# ------------------------------------------------------------------------------
# Set this to your production domain(s), comma-separated.
# Note: Vercel preview URLs (*.vercel.app) are automatically accepted by backend regex.
CORS_ORIGINS=https://ridecompare.vercel.app
ALLOWED_ORIGINS=https://ridecompare.vercel.app
ML_ALLOWED_ORIGINS=https://ridecompare.vercel.app

# ------------------------------------------------------------------------------
# 3. SECURITY & ADMIN KEY
# ------------------------------------------------------------------------------
# Secret key used for administrative actions and health checks.
ADMIN_KEY=rc_live_admin_9f3b7c2a1e4d805b6e2c8a4f7d0e3b1a

# ------------------------------------------------------------------------------
# 4. DATABASE (POSTGRESQL / SQLITE)
# ------------------------------------------------------------------------------
# If you attached the Vercel Neon integration, Vercel automatically sets POSTGRES_URL
# and DATABASE_URL. If you are using an external Postgres, enter the connection string here:
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-wandering-thunder.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# If left as sqlite, backend automatically creates an ephemeral database in /tmp/ridecompare.db
DATABASE_URL=sqlite:///./ridecompare.db

# ------------------------------------------------------------------------------
# 5. FRONTEND (Vite)
# ------------------------------------------------------------------------------
# When deployed together on Vercel, leave VITE_API_URL EMPTY!
# vercel.json rewrites /api/* directly to the /api/index.py serverless backend.
# (Only set this if your backend is hosted separately, e.g. on Render)
VITE_API_URL=

# ------------------------------------------------------------------------------
# 6. GEOCODING & MAP SERVICES
# ------------------------------------------------------------------------------
# Geocoding provider: 'mapbox' (best search autocomplete) or 'photon' (100% free, no key needed)
GEOCODING_PROVIDER=mapbox

# Mapbox Tokens (Sign up free at https://www.mapbox.com)
# Replace with your actual Mapbox tokens, or set GEOCODING_PROVIDER=photon if you don't have one
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here
MAPBOX_PUBLIC_TOKEN=your_mapbox_public_token_here
MAPBOX_SECRET_TOKEN=
MAPBOX_SERVER_TOKEN=
VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_public_token_here

# OpenStreetMap / Photon Fallback URLs
PHOTON_BASE_URL=https://photon.komoot.io
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=RideCompare/3.0 (https://ridecompare.vercel.app; contact: admin@ridecompare.com)
LOCATION_CACHE_TTL_DAYS=14

# Optional Geoapify Geocoding API Key (Alternative provider)
GEOAPIFY_API_KEY=

# ------------------------------------------------------------------------------
# 7. OPTIONAL RIDE PROVIDER APIS
# ------------------------------------------------------------------------------
# Leave empty to use RideCompare's high-fidelity ML fare estimation model.
UBER_API_KEY=
LYFT_API_KEY=
OLA_API_KEY=
RAPIDO_API_KEY=
BOLT_API_KEY=
GRAB_API_KEY=
